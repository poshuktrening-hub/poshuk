# Безпека для всіх відповідей: не вбудовувати сайт у чужі сторінки, не вгадувати тип файлів, лише свої скрипти
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://upload.wikimedia.org https://commons.wikimedia.org; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://commons.wikimedia.org https://upload.wikimedia.org; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
# Скрипти, стилі й шрифти підключені з версією (?v=…), яку змінює кожен реліз — тому їх можна тримати в кеші рік
/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/style.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/fonts.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/config.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# Картинки правил, відео тла, іконки — без версії в адресі, тому день
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
